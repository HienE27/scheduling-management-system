# Hospital Scheduler - Frontend Dockerfile (built from repo root)
# Build context: repo root; sources are copied from frontend/ subdir

# Stage 1: Install dependencies (cached when package.json hasn't changed)
FROM node:20-alpine AS deps
WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy only manifest files first for dependency caching
COPY frontend/package.json frontend/pnpm-lock.yaml* frontend/.npmrc* ./
RUN pnpm install --no-frozen-lockfile

# Stage 2: Build the Next.js application
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy only the frontend source
COPY frontend/. ./

# Disable telemetry during build
ENV NEXT_TELEMETRY_DISABLED=1

# Inject backend URL for Next.js rewrites at build time
# (next.config.ts rewrites /api/* → $REWRITE_DEST/api/*)
ENV REWRITE_DEST=https://scheduling-management-system.onrender.com

# Build the application
RUN pnpm build

# Stage 3: Production runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy public assets
COPY --from=builder /app/public ./public

# Set permissions for prerender cache
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Copy the built standalone application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to non-root user
USER nextjs

# Expose Next.js port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000 || exit 1

# Start the Next.js production server
CMD ["node", "server.js"]
