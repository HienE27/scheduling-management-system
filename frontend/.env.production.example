# Hospital Scheduler — Production Environment Variables (Render backend)
# Set these in Vercel Project Settings → Environment Variables (Production)

# API base URL is REWRITE_DEST (used by next.config.ts rewrites)
# When the browser hits /api/*, Next.js proxies to this URL.
REWRITE_DEST=https://scheduling-management-system.onrender.com

# Public API URL exposed to the client (used by realtime ws + auth flows)
NEXT_PUBLIC_API_URL=https://scheduling-management-system.onrender.com/api/v1
